# Copy this file to .env and fill it in. Never commit .env.
# Only `npm run verify:live` reads it. The calculator itself needs no secrets.

# Upstox access token. It expires every day at about 3:30 AM IST, so paste a fresh one before each run.
UPSTOX_ACCESS_TOKEN=

# Instrument key of an option that is listed today, for example NSE_FO|12345.
# Keys change with every expiry. `npm run verify:live -- --help` explains where to find one.
UPSTOX_INSTRUMENT_KEY=
